NODE_ENV=development
PORT=4000
DATABASE_URL=file:./dev.db
JWT_SECRET=replace-with-a-unique-random-value-at-least-32-bytes-long
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Render origins. For local development you can use:
# ADMIN_URL=http://localhost:5173
# CLIENT_URL=http://localhost:5174
# USER_URL=http://localhost:5175
ADMIN_URL=https://nearbycaters-admin.onrender.com
CLIENT_URL=https://nearbycaters-client.onrender.com
USER_URL=https://nearbycaters-frontend-userapp.onrender.com
API_BASE_URL=https://nearbycaters.onrender.com

# Optional integrations. Keep credentials server-side only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RESEND_API_KEY=
MAIL_FROM=
FIREBASE_SERVICE_ACCOUNT_PATH=
